# PandaPulse AI Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Ollama & Models
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3:8b
EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Vector DB & Storage
CHROMA_PERSIST_DIRECTORY=./chroma_db
DOCS_DIRECTORY=./data/pandas_docs
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=3

# Caching
CACHE_CAPACITY=256
CACHE_ENABLED=true
