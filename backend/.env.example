# PandaPulse AI Production & Environment Configuration

# Server & Runtime
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Admin Protection (Leave empty for open dev, set strong random string for production)
ADMIN_API_KEY=

# Rate Limiting (Safeguards inference quotas)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Cloud Inference (Zero local download execution)
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local Ollama (Offline fallback)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:1.5b
EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.65
LLM_MAX_TOKENS=2048

# ChromaDB Vector Storage & Ingestion
CHROMA_PERSIST_DIRECTORY=./chroma_db
DOCS_DIRECTORY=./data/pandas_docs
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=3

# In-Memory Cache
CACHE_CAPACITY=256
CACHE_ENABLED=true
